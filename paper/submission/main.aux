\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces LIBERO-Object target start poses, read directly from the shipped init files. \textbf  {\#pos} counts \emph  {distinct float64 positions} over the 50 states; where it is 2 the two values differ by one ULP ($\sim 3\times 10^{-17}$\,m) on a single axis (soup splits 23/27 on $y$; tomato sauce 18/32 on $x$). \textbf  {\#quat} counts distinct orientation quaternions: \emph  {one} in every task, so rotation is bit-identical suite-wide even where position jitters. Clusters are 22.04\,cm apart; within-cluster max pairwise separation is 0.95\,mm (A) and 0.63\,mm (B). The basket moves at most 4.04\,mm across all ten tasks. Per-task SHA-256 digests of the init arrays are in \texttt  {results/placement\_pinning\_direct.json}; \texttt  {.init} and \texttt  {.pruned\_init} give identical target statistics.}}{3}{table.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:pinning}{{1}{3}{LIBERO-Object target start poses, read directly from the shipped init files. \textbf {\#pos} counts \emph {distinct float64 positions} over the 50 states; where it is 2 the two values differ by one ULP ($\sim 3\times 10^{-17}$\,m) on a single axis (soup splits 23/27 on $y$; tomato sauce 18/32 on $x$). \textbf {\#quat} counts distinct orientation quaternions: \emph {one} in every task, so rotation is bit-identical suite-wide even where position jitters. Clusters are 22.04\,cm apart; within-cluster max pairwise separation is 0.95\,mm (A) and 0.63\,mm (B). The basket moves at most 4.04\,mm across all ten tasks. Per-task SHA-256 digests of the init arrays are in \texttt {results/placement\_pinning\_direct.json}; \texttt {.init} and \texttt {.pruned\_init} give identical target statistics}{table.caption.2}{}}
