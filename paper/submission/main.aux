\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Primary-target placement across LIBERO suites, 50 shipped states per task. \textbf  {pinned} = targets with $\le 2$ distinct float64 positions; \textbf  {$H$} = mean per-task placement entropy at 1\,mm against a 5.644-bit ceiling; \textbf  {distinct} = mean distinct 1\,mm placements per task; \textbf  {max sep.} = largest pairwise distance between task-mean target positions. Denominators are \emph  {resolvable} tasks: libero-goal's ``open the middle drawer'' and ``turn on the stove'' name a fixture with no free joint and so have no placement to measure; they are excluded and counted, not scored as unpinned. \texttt  {:obj\_of\_interest} lists the manipulated object first and the destination second, and the two are never pooled---averaging a frozen target with a jittering receptacle reports every libero-object task as unpinned, which is false. Artifacts, per-task rows and SHA-256 digests: \texttt  {results/suite\_forensics\_\{columns,joints\}.json}.}}{4}{table.caption.3}\protected@file@percent }
\newlabel{tab:suites}{{2}{4}{Primary-target placement across LIBERO suites, 50 shipped states per task. \textbf {pinned} = targets with $\le 2$ distinct float64 positions; \textbf {$H$} = mean per-task placement entropy at 1\,mm against a 5.644-bit ceiling; \textbf {distinct} = mean distinct 1\,mm placements per task; \textbf {max sep.} = largest pairwise distance between task-mean target positions. Denominators are \emph {resolvable} tasks: libero-goal's ``open the middle drawer'' and ``turn on the stove'' name a fixture with no free joint and so have no placement to measure; they are excluded and counted, not scored as unpinned. \texttt {:obj\_of\_interest} lists the manipulated object first and the destination second, and the two are never pooled---averaging a frozen target with a jittering receptacle reports every libero-object task as unpinned, which is false. Artifacts, per-task rows and SHA-256 digests: \texttt {results/suite\_forensics\_\{columns,joints\}.json}}{table.caption.3}{}}
\citation{liu2023libero}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Placement forensics. \textbf  {A} libero-object primary targets, 10 tasks $\times $ 50 shipped states: six collapse to a point, and the ten task means occupy two clusters 22.1\,cm apart. \textbf  {B} libero-spatial on identical axes: every target scatters---and it must, because all ten of its targets are a ``black bowl'', so identity alone cannot disambiguate the task and position has to carry the information. \textbf  {C} placement entropy per suite against the 5.644-bit ceiling.}}{5}{figure.caption.4}\protected@file@percent }
\newlabel{fig:forensics}{{1}{5}{Placement forensics. \textbf {A} libero-object primary targets, 10 tasks $\times $ 50 shipped states: six collapse to a point, and the ten task means occupy two clusters 22.1\,cm apart. \textbf {B} libero-spatial on identical axes: every target scatters---and it must, because all ten of its targets are a ``black bowl'', so identity alone cannot disambiguate the task and position has to carry the information. \textbf {C} placement entropy per suite against the 5.644-bit ceiling}{figure.caption.4}{}}
