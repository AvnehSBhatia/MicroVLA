\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Placement forensics. \textbf  {A} LIBERO-Object primary targets, $10$ tasks $\times $ $50$ shipped states; six collapse to a point and the ten task means occupy two clusters $22.1$\,cm apart. \textbf  {B} LIBERO-Spatial on identical axes: every target scatters, and it must, because all ten of its targets are a ``black bowl''. \textbf  {C} placement entropy per suite against the $5.644$-bit ceiling. Generated by \texttt  {paper/render\_fig1\_placement\_forensics.py} from \texttt  {results/suite\_forensics\_joints.json}; per-task rows are in that artifact and SHA-256 digests of every init-state array are in \texttt  {results/suite\_forensics\_columns.json}.}}{5}{figure.caption.12}\protected@file@percent }
\newlabel{fig:forensics}{{1}{5}{Placement forensics. \textbf {A} LIBERO-Object primary targets, $10$ tasks $\times $ $50$ shipped states; six collapse to a point and the ten task means occupy two clusters $22.1$\,cm apart. \textbf {B} LIBERO-Spatial on identical axes: every target scatters, and it must, because all ten of its targets are a ``black bowl''. \textbf {C} placement entropy per suite against the $5.644$-bit ceiling. Generated by \texttt {paper/render\_fig1\_placement\_forensics.py} from \texttt {results/suite\_forensics\_joints.json}; per-task rows are in that artifact and SHA-256 digests of every init-state array are in \texttt {results/suite\_forensics\_columns.json}}{figure.caption.12}{}}
