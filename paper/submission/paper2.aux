\@writefile{lot}{\contentsline {table}{\numberline {15}{\ignorespaces Tasks whose identity-bearing object one constant serves, against the tolerance. \textbf  {The separation is real at $1.4$\,cm and gone by $1.9$\,cm}, and those two numbers are our own two measurements of the same assumption (\S  \ref {sec:refute}): task $0$ fails at basket displacements from $1.41$\,cm, task $3$ tolerates $1.91$\,cm. We report the headline at the smaller one, which is the value that favours us. At the larger one LIBERO-Object is still $10/10$ but so are thirteen tasks elsewhere, and the contrast is no longer a separation. Artifact: \texttt  {results/admissibility.json}.}}{14}{table.caption.55}\protected@file@percent }
\newlabel{tab:deltasens}{{15}{14}{Tasks whose identity-bearing object one constant serves, against the tolerance. \textbf {The separation is real at $1.4$\,cm and gone by $1.9$\,cm}, and those two numbers are our own two measurements of the same assumption (\S \ref {sec:refute}): task $0$ fails at basket displacements from $1.41$\,cm, task $3$ tolerates $1.91$\,cm. We report the headline at the smaller one, which is the value that favours us. At the larger one LIBERO-Object is still $10/10$ but so are thirteen tasks elsewhere, and the contrast is no longer a separation. Artifact: \texttt {results/admissibility.json}}{table.caption.55}{}}
