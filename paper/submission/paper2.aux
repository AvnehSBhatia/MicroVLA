\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Every task of both suites --- nothing selected, nothing averaged.} Each panel is one task on identical axes: the shaded square is the sampling region that task's own BDDL declares, the dots are the fifty initial states the benchmark ships, and the number beneath is the shipped spread. \textbf  {Every LIBERO-Long task fills its declared box; no LIBERO-Object task does, and six are a single point.} The two rows are the whole of \S  \ref {sec:declared}, and no tolerance, controller, policy or simulator enters the comparison. Generated by \texttt  {paper/render\_fig13\_allsmall.py}.}}{5}{figure.caption.9}\protected@file@percent }
\newlabel{fig:alltasks}{{2}{5}{\textbf {Every task of both suites --- nothing selected, nothing averaged.} Each panel is one task on identical axes: the shaded square is the sampling region that task's own BDDL declares, the dots are the fifty initial states the benchmark ships, and the number beneath is the shipped spread. \textbf {Every LIBERO-Long task fills its declared box; no LIBERO-Object task does, and six are a single point.} The two rows are the whole of \S \ref {sec:declared}, and no tolerance, controller, policy or simulator enters the comparison. Generated by \texttt {paper/render\_fig13\_allsmall.py}}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {The region a LIBERO task declares, against the states it ships.} The shaded square is the sampling box the task's own BDDL specifies; the dots are the fifty shipped initial states. \textbf  {A} LIBERO-Object task $0$: a $5 \times 5$\,cm declaration, and all fifty states at one point. \textbf  {B} LIBERO-Long task $0$, same generator, the identical $5 \times 5$\,cm declaration, drawn on the same scale: the states fill it. No tolerance, controller, policy or simulator enters this comparison --- it is two shipped files. Generated by \texttt  {paper/render\_fig10\_declared.py}.}}{5}{figure.caption.10}\protected@file@percent }
\newlabel{fig:declared}{{3}{5}{\textbf {The region a LIBERO task declares, against the states it ships.} The shaded square is the sampling box the task's own BDDL specifies; the dots are the fifty shipped initial states. \textbf {A} LIBERO-Object task $0$: a $5 \times 5$\,cm declaration, and all fifty states at one point. \textbf {B} LIBERO-Long task $0$, same generator, the identical $5 \times 5$\,cm declaration, drawn on the same scale: the states fill it. No tolerance, controller, policy or simulator enters this comparison --- it is two shipped files. Generated by \texttt {paper/render\_fig10\_declared.py}}{figure.caption.10}{}}
