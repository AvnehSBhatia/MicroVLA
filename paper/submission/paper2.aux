\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {What the blind constant's failures are made of.} \textbf  {A} On task $0$, which trials fail is predicted by how far that shipped state's basket sits from the single constant the blind arm was given: the four failures are the four largest displacements, one rank inversion, exact Mann-Whitney $p = 0.019$. \textbf  {B} On task $3$ the same quantity runs higher --- four of ten states exceed task $0$'s largest \emph  {success} --- and every trial succeeds. So A1 holds at a radius, that radius explains which trials fail within a task, and it is not the same radius across tasks. Artifacts: \texttt  {results/blind\_failure\_attribution.json}, \texttt  {results/suite\_forensics\_joints.json}.}}{7}{figure.caption.21}\protected@file@percent }
\newlabel{fig:subgoal}{{3}{7}{\textbf {What the blind constant's failures are made of.} \textbf {A} On task $0$, which trials fail is predicted by how far that shipped state's basket sits from the single constant the blind arm was given: the four failures are the four largest displacements, one rank inversion, exact Mann-Whitney $p = 0.019$. \textbf {B} On task $3$ the same quantity runs higher --- four of ten states exceed task $0$'s largest \emph {success} --- and every trial succeeds. So A1 holds at a radius, that radius explains which trials fail within a task, and it is not the same radius across tasks. Artifacts: \texttt {results/blind\_failure\_attribution.json}, \texttt {results/suite\_forensics\_joints.json}}{figure.caption.21}{}}
