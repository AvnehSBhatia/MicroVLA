\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Which of the $50$ shipped initial states composes each evaluation cell, derived from the harness's seeding rule rather than logged. Because $\texttt  {trial\_seed} = \texttt  {seed}\cdot 1{,}000{,}003 + \texttt  {trial}$ and $1{,}000{,}003 \equiv 3 \pmod  {50}$, trial $i$ at seed $s$ replays state $(3s+i) \bmod  50$. The bolded rows are the ones that matter: an $n{=}50$ cell is the entire state set and therefore \emph  {contains} the dev and held-out bands rather than being disjoint from them.}}{6}{table.caption.20}\protected@file@percent }
\newlabel{tab:bands}{{5}{6}{Which of the $50$ shipped initial states composes each evaluation cell, derived from the harness's seeding rule rather than logged. Because $\texttt {trial\_seed} = \texttt {seed}\cdot 1{,}000{,}003 + \texttt {trial}$ and $1{,}000{,}003 \equiv 3 \pmod {50}$, trial $i$ at seed $s$ replays state $(3s+i) \bmod 50$. The bolded rows are the ones that matter: an $n{=}50$ cell is the entire state set and therefore \emph {contains} the dev and held-out bands rather than being disjoint from them}{table.caption.20}{}}
