\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Placement entropy of every LIBERO suite, $50$ shipped states per task, ceiling $\log _2 50 = 5.644$ bits, swept over tolerance. \emph  {spread} is the mean over tasks of the largest deviation of any shipped placement from its task mean --- a physical statistic with no definitional choices at all, which separates the suites by $6.5$--$10.6\times $ on its own. Denominators are \emph  {resolvable} tasks: two LIBERO-Goal tasks name a fixture with no free joint and have no placement to measure, so they are excluded and counted rather than scored as unpinned. Artifact: \texttt  {results/placement\_entropy.json}.}}{3}{table.caption.6}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:suites}{{1}{3}{Placement entropy of every LIBERO suite, $50$ shipped states per task, ceiling $\log _2 50 = 5.644$ bits, swept over tolerance. \emph {spread} is the mean over tasks of the largest deviation of any shipped placement from its task mean --- a physical statistic with no definitional choices at all, which separates the suites by $6.5$--$10.6\times $ on its own. Denominators are \emph {resolvable} tasks: two LIBERO-Goal tasks name a fixture with no free joint and have no placement to measure, so they are excluded and counted rather than scored as unpinned. Artifact: \texttt {results/placement\_entropy.json}}{table.caption.6}{}}
