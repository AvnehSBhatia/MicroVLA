\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {All ten LIBERO-Object tasks}, $n{=}10$ each, every trial recorded; both policies drive the identical controller. Eight of ten tasks are $0$--$0$. The suite totals in \textbf  {B} are shown with i.i.d.\ Wilson intervals, which are \emph  {too narrow} here by a design effect of $8.4$ (\S  \ref {sec:refute}); they are drawn as reported rather than as believed. Artifacts: \texttt  {results/suite\_cells.json}, \texttt  {results/suite\_inference.json}.}}{9}{figure.caption.29}\protected@file@percent }
\newlabel{fig:suite}{{7}{9}{\textbf {All ten LIBERO-Object tasks}, $n{=}10$ each, every trial recorded; both policies drive the identical controller. Eight of ten tasks are $0$--$0$. The suite totals in \textbf {B} are shown with i.i.d.\ Wilson intervals, which are \emph {too narrow} here by a design effect of $8.4$ (\S \ref {sec:refute}); they are drawn as reported rather than as believed. Artifacts: \texttt {results/suite\_cells.json}, \texttt {results/suite\_inference.json}}{figure.caption.29}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces The same comparison at two units of analysis. Trials within a task share an object, a scene, a goal supply and a near-deterministic trajectory, so the trial-level test is anti-conservative. \textbf  {The task-level tests do not show equivalence --- they show this design cannot resolve the question in either direction.} With eight ties the sign test has two informative units and its smallest attainable $p$ is $0.5$; the permutation test has four arrangements and the same floor. Reading $p = 1.0$ as ``no difference'' would repeat, in the other direction, the error this section withdraws. The design effect ($\approx 8$, bootstrap $[5.4, 10.0]$, estimated from one non-degenerate cluster) is reported as a description of the clustering, not as a correction to any $p$. Artifact: \texttt  {results/suite\_inference.json}.}}{9}{table.caption.31}\protected@file@percent }
\newlabel{tab:fullsuite}{{7}{9}{The same comparison at two units of analysis. Trials within a task share an object, a scene, a goal supply and a near-deterministic trajectory, so the trial-level test is anti-conservative. \textbf {The task-level tests do not show equivalence --- they show this design cannot resolve the question in either direction.} With eight ties the sign test has two informative units and its smallest attainable $p$ is $0.5$; the permutation test has four arrangements and the same floor. Reading $p = 1.0$ as ``no difference'' would repeat, in the other direction, the error this section withdraws. The design effect ($\approx 8$, bootstrap $[5.4, 10.0]$, estimated from one non-degenerate cluster) is reported as a description of the clustering, not as a correction to any $p$. Artifact: \texttt {results/suite\_inference.json}}{table.caption.31}{}}
\@writefile{toc}{\contentsline {paragraph}{Where A1 does break, we can see it.}{9}{section*.34}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces \textbf  {The goal supply does not explain the outcome.} Four tasks receive the same constant to within half a millimetre in all three axes and score $0$, $0$, $0$ and $10$ out of ten. This is a deterministic contrast, not a statistical one. We previously also offered a correlation between placement radius and success ($r = +0.52$) as evidence here; \textbf  {we withdraw it}. Its exact permutation $p$ is $0.13$ and deleting task $3$ flips it to $-0.25$ --- the sign is one task, the error this section reports. Artifact: \texttt  {results/constant\_attribution.json}.}}{9}{table.caption.33}\protected@file@percent }
\newlabel{tab:attrib}{{8}{9}{\textbf {The goal supply does not explain the outcome.} Four tasks receive the same constant to within half a millimetre in all three axes and score $0$, $0$, $0$ and $10$ out of ten. This is a deterministic contrast, not a statistical one. We previously also offered a correlation between placement radius and success ($r = +0.52$) as evidence here; \textbf {we withdraw it}. Its exact permutation $p$ is $0.13$ and deleting task $3$ flips it to $-0.25$ --- the sign is one task, the error this section reports. Artifact: \texttt {results/constant\_attribution.json}}{table.caption.33}{}}
