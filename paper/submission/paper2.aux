\@writefile{toc}{\contentsline {subsection}{\numberline {8.1}Randomisation is a curve, not a point}{12}{subsection.8.1}\protected@file@percent }
\newlabel{sec:sweep}{{8.1}{12}{Randomisation is a curve, not a point}{subsection.8.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Sweeping the placement-randomisation radius on the same draws. Randomisation robustness is a curve, and at $n{=}10$ this curve is not even monotone --- the undisplaced cell sits \emph  {below} $\pm 2$\,cm, which cannot be a real benefit of displacement. Reporting any single radius as ``passes randomisation'' would quote a number this sample does not resolve, and we do not use this table to set any threshold elsewhere in the paper. $^\ddagger $Per-trial outcomes for the $\pm 2$, $\pm 6$ and $\pm 8$ rows are in \texttt  {results/pod\_cells.json}; the two marked rows were measured in an earlier session and their trial records are not in the repository.}}{12}{table.caption.47}\protected@file@percent }
\newlabel{tab:sweep}{{11}{12}{Sweeping the placement-randomisation radius on the same draws. Randomisation robustness is a curve, and at $n{=}10$ this curve is not even monotone --- the undisplaced cell sits \emph {below} $\pm 2$\,cm, which cannot be a real benefit of displacement. Reporting any single radius as ``passes randomisation'' would quote a number this sample does not resolve, and we do not use this table to set any threshold elsewhere in the paper. $^\ddagger $Per-trial outcomes for the $\pm 2$, $\pm 6$ and $\pm 8$ rows are in \texttt {results/pod\_cells.json}; the two marked rows were measured in an earlier session and their trial records are not in the repository}{table.caption.47}{}}
