\newlabel{prop:lookup}{{1}{7}{Lookup sufficiency}{proposition.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Definition~\ref {def:D} and Proposition~\ref {prop:lookup}, drawn.} One task per suite, each at its suite's median radius. Dots are the fifty shipped target positions; the solid circle is the smallest disc containing them, so its radius \emph  {is} $R$ and its centre \emph  {is} the constant the proof of Proposition~\ref {prop:lookup} constructs. The shaded disc is the tolerance $\delta $. The criterion $R \le \delta $ is then a picture: the shipped points fit inside the shaded disc, or they do not. Generated by \texttt  {paper/render\_fig11\_radius.py}.}}{8}{figure.caption.26}\protected@file@percent }
\newlabel{fig:criterion}{{5}{8}{\textbf {Definition~\ref {def:D} and Proposition~\ref {prop:lookup}, drawn.} One task per suite, each at its suite's median radius. Dots are the fifty shipped target positions; the solid circle is the smallest disc containing them, so its radius \emph {is} $R$ and its centre \emph {is} the constant the proof of Proposition~\ref {prop:lookup} constructs. The shaded disc is the tolerance $\delta $. The criterion $R \le \delta $ is then a picture: the shipped points fit inside the shaded disc, or they do not. Generated by \texttt {paper/render\_fig11\_radius.py}}{figure.caption.26}{}}
\newlabel{cor:sep}{{1}{8}{No score can separate them}{corollary.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Measurement}{8}{subsection.3.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Placement radius of every LIBERO task, computed from the shipped initial states alone --- no policy, no simulator, no training. The radii need no tolerance; the last column does, and counts tasks whose identity-bearing object a single constant serves \textbf  {at $\delta = 1.41$\,cm} (\S  \ref {sec:refute}) --- a value \S  \ref {sec:e2} goes on to measure directly and overturn, which changes this column and nothing to its left. \textbf  {At that $\delta $, LIBERO-Object pins all ten of the objects its tasks are individuated by; elsewhere two of thirty}, and $^\dagger $both of those are the fixture tasks --- a drawer and a stove --- which have $R = 0$ because they are bolted down, not because a randomisable placement was frozen. On the shared container the ordering \textbf  {reverses}: LIBERO-Object pins it in $0$ of $10$ tasks and LIBERO-Goal in $6$ of $8$, whose shared objects are fixtures. So LIBERO-Object is not the suite that pins the most --- it is the suite that pins the object its tasks are \emph  {named} by, which is the distinction this paper is about and the reason the two columns are reported separately. Artifact: \texttt  {results/admissibility.json}.}}{8}{table.caption.27}\protected@file@percent }
\newlabel{tab:suites}{{6}{8}{Placement radius of every LIBERO task, computed from the shipped initial states alone --- no policy, no simulator, no training. The radii need no tolerance; the last column does, and counts tasks whose identity-bearing object a single constant serves \textbf {at $\delta = 1.41$\,cm} (\S \ref {sec:refute}) --- a value \S \ref {sec:e2} goes on to measure directly and overturn, which changes this column and nothing to its left. \textbf {At that $\delta $, LIBERO-Object pins all ten of the objects its tasks are individuated by; elsewhere two of thirty}, and $^\dagger $both of those are the fixture tasks --- a drawer and a stove --- which have $R = 0$ because they are bolted down, not because a randomisable placement was frozen. On the shared container the ordering \textbf {reverses}: LIBERO-Object pins it in $0$ of $10$ tasks and LIBERO-Goal in $6$ of $8$, whose shared objects are fixtures. So LIBERO-Object is not the suite that pins the most --- it is the suite that pins the object its tasks are \emph {named} by, which is the distinction this paper is about and the reason the two columns are reported separately. Artifact: \texttt {results/admissibility.json}}{table.caption.27}{}}
\@writefile{toc}{\contentsline {paragraph}{How pinned is pinned.}{8}{section*.29}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Placement forensics. \textbf  {A} LIBERO-Object's identity-bearing targets, $10$ tasks $\times $ $50$ shipped states; six collapse to a point and the ten task means occupy two clusters $22.1$\,cm apart. \textbf  {B} LIBERO-Spatial on identical axes: every target scatters, and it must, because all ten of its targets are a ``black bowl'' and identity cannot disambiguate them. \textbf  {C} placement radius per task against the tolerance measured for this controller. Generated by \texttt  {paper/render\_fig1\_placement\_forensics.py}; SHA-256 digests of every init-state array are in \texttt  {results/suite\_forensics\_columns.json}.}}{9}{figure.caption.28}\protected@file@percent }
\newlabel{fig:forensics}{{6}{9}{Placement forensics. \textbf {A} LIBERO-Object's identity-bearing targets, $10$ tasks $\times $ $50$ shipped states; six collapse to a point and the ten task means occupy two clusters $22.1$\,cm apart. \textbf {B} LIBERO-Spatial on identical axes: every target scatters, and it must, because all ten of its targets are a ``black bowl'' and identity cannot disambiguate them. \textbf {C} placement radius per task against the tolerance measured for this controller. Generated by \texttt {paper/render\_fig1\_placement\_forensics.py}; SHA-256 digests of every init-state array are in \texttt {results/suite\_forensics\_columns.json}}{figure.caption.28}{}}
