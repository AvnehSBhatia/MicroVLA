\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Admissibility predicts sub-goal by sub-goal, inside one task.} \textbf  {A} ``Pick up the alphabet soup and place it in the basket'' has two sub-goals with two diameters: the soup occupies the \emph  {same} \texttt  {float64} position in all fifty shipped states ($D = 0.00$\,cm), the basket does not ($D = 3.37$\,cm). \textbf  {B} What the blind constant did, per trial. It closed on the object to within $2$\,mm in \emph  {all ten}, failures included; the four failures ran to the step cap with the object still $8$\,mm from the gripper --- grasped, never placed. The same constant-driven controller performed both sub-goals, so the diameter is the only thing distinguishing them. Artifacts: \texttt  {results/suite\_forensics\_joints.json}, \texttt  {results/blind\_logs/blind\_t0\_trials.txt}.}}{7}{figure.caption.21}\protected@file@percent }
\newlabel{fig:subgoal}{{3}{7}{\textbf {Admissibility predicts sub-goal by sub-goal, inside one task.} \textbf {A} ``Pick up the alphabet soup and place it in the basket'' has two sub-goals with two diameters: the soup occupies the \emph {same} \texttt {float64} position in all fifty shipped states ($D = 0.00$\,cm), the basket does not ($D = 3.37$\,cm). \textbf {B} What the blind constant did, per trial. It closed on the object to within $2$\,mm in \emph {all ten}, failures included; the four failures ran to the step cap with the object still $8$\,mm from the gripper --- grasped, never placed. The same constant-driven controller performed both sub-goals, so the diameter is the only thing distinguishing them. Artifacts: \texttt {results/suite\_forensics\_joints.json}, \texttt {results/blind\_logs/blind\_t0\_trials.txt}}{figure.caption.21}{}}
