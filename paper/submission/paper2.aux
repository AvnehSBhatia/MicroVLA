\@writefile{toc}{\contentsline {paragraph}{The constant is not what produced the successes.}{7}{section*.25}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces \textbf  {The goal supply does not explain the outcome.} Tasks whose constants are identical to within a millimetre score anywhere from $0/10$ to $10/10$. Tasks given a \emph  {bit-exact} constant ($R=0$) score $6/60$; tasks given the loosest constants ($R > 1$\,cm) score $10/40$. The correlation between placement radius and success is $r = +0.52$. We attribute that to the informal lookup reading rather than to Proposition~\ref {prop:lookup}, whose hypotheses do not hold here anyway --- admissibility fails on the container, A1 is task-dependent, and our policy is outside Corollary~\ref {cor:sep}'s class. Artifact: \texttt  {results/constant\_attribution.json}.}}{7}{table.caption.26}\protected@file@percent }
\newlabel{tab:attrib}{{6}{7}{\textbf {The goal supply does not explain the outcome.} Tasks whose constants are identical to within a millimetre score anywhere from $0/10$ to $10/10$. Tasks given a \emph {bit-exact} constant ($R=0$) score $6/60$; tasks given the loosest constants ($R > 1$\,cm) score $10/40$. The correlation between placement radius and success is $r = +0.52$. We attribute that to the informal lookup reading rather than to Proposition~\ref {prop:lookup}, whose hypotheses do not hold here anyway --- admissibility fails on the container, A1 is task-dependent, and our policy is outside Corollary~\ref {cor:sep}'s class. Artifact: \texttt {results/constant\_attribution.json}}{table.caption.26}{}}
