\@writefile{toc}{\contentsline {subsection}{\numberline {9.3}Matching a rate is not reproducing a sample}{14}{subsection.9.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {14}{\ignorespaces Changing only the OpenGL backend MuJoCo renders through --- same seed, same trials, same weights, same package versions. The aggregate is identical and $40\%$ of the individual episodes are not --- though \S  \ref {sec:cert} withdraws the attribution of that difference to the backend change itself. Matching a published rate is therefore weak evidence of having reproduced an experiment, and any paired statistic computed across a renderer change is invalid, because pairing assumes the trials are the same trials.}}{14}{table.caption.50}\protected@file@percent }
\newlabel{tab:renderer}{{14}{14}{Changing only the OpenGL backend MuJoCo renders through --- same seed, same trials, same weights, same package versions. The aggregate is identical and $40\%$ of the individual episodes are not --- though \S \ref {sec:cert} withdraws the attribution of that difference to the backend change itself. Matching a published rate is therefore weak evidence of having reproduced an experiment, and any paired statistic computed across a renderer change is invalid, because pairing assumes the trials are the same trials}{table.caption.50}{}}
