\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces \textbf  {Written before the arm was run}, so the reading could not be chosen afterwards --- which is error~7 of \S  \ref {sec:neg}. Both branches were implemented and calibrated on synthetic cells first (\texttt  {scripts/analyze\_e5.py}); the script also refuses a verdict on an incomplete cell, tested on a short cell whose partial data would have rejected.}}{7}{table.caption.17}\protected@file@percent }
\newlabel{tab:e5plan}{{5}{7}{\textbf {Written before the arm was run}, so the reading could not be chosen afterwards --- which is error~7 of \S \ref {sec:neg}. Both branches were implemented and calibrated on synthetic cells first (\texttt {scripts/analyze\_e5.py}); the script also refuses a verdict on an incomplete cell, tested on a short cell whose partial data would have rejected}{table.caption.17}{}}
